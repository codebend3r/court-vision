{
  "name": "court-vision",
  "version": "0.4.4",
  "private": true,
  "scripts": {
    "predev": "build-meta --src-folder public --env development",
    "dev": "next dev --port 46644",
    "prebuild": "build-meta --src-folder public --env production",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsgo --noEmit",
    "test": "bun test --parallel --dots",
    "test:watch": "bun test --isolate --watch",
    "test:a11y": "playwright test",
    "perf:budget": "bun run scripts/perf-budget.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "sync:nba": "bun run src/lib/nba/sync.ts",
    "sync:bdl": "bun run src/lib/balldontlie/sync.ts",
    "sync:players": "bun run src/lib/balldontlie/sync-players.ts",
    "sync:nightly": "bun run src/lib/balldontlie/sync-nightly.ts",
    "seed:demo": "bun run src/lib/demo/seed.ts",
    "map:headshots": "bun run src/lib/headshots/map.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@vision/core": "workspace:*",
    "@vision/sport-basketball": "workspace:*",
    "@vision/ui": "workspace:*",
    "lucide-react": "1.50.0",
    "next": "16.3.8",
    "nuqs": "2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vision/testing": "workspace:*",
    "build-meta": "0.1.1",
    "dotenv": "18.0.5",
    "prisma": "7.10.0",
    "sass": "1.105.1"
  }
}
