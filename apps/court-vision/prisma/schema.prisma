// Court Vision Prisma schema: Player / PlayerSeasonStats / PlayerGameLog.
// See PRD §8 (Data and Sync Strategy).
//
// Prisma 7: the connection URL lives in prisma.config.ts (not here), and the
// client is generated to ../generated/prisma via the `prisma-client` generator.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id               Int                     @id
  firstName        String
  lastName         String
  fullName         String
  teamId           Int?
  teamAbbr         String?
  position         String?
  jerseyNumber     String?
  nbaPersonId      Int?
  heightInches     Int?
  weightLbs        Int?
  birthDate        DateTime?
  college          String?
  country          String?
  draftYear        Int?
  draftRound       Int?
  draftNumber      Int?
  // On a current NBA roster per Balldontlie's /v1/players/active, refreshed by
  // `sync:players`. Team rosters read this, not game logs, so rookies and new
  // signings appear before they play.
  isActive         Boolean                 @default(false)
  seasonStats      PlayerSeasonStats[]
  gameLogs         PlayerGameLog[]
  advancedGameLogs PlayerAdvancedGameLog[]
  leagueWatchlist  LeagueWatchlistPlayer[]
  leagueTeamSlots  LeagueTeamSlot[]
  externalIds      PlayerExternalId[]
  leagueWaivers    LeagueWaiverPlayer[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
}

model Profile {
  id               String   @id @db.Uuid
  email            String
  username         String   @unique
  tier             String   @default("free")
  displayName      String?
  // User preferences (spec: settings page). preferredFormula is a
  // FantasyMethodKey; fontScale is "sm" | "default" | "lg" | "xl" — both
  // validated by guards at the edges, stored as plain strings.
  preferredFormula String?
  fontScale        String   @default("default")
  activeLeagueId   String?
  activeLeague     League?  @relation("ActiveLeague", fields: [activeLeagueId], references: [id], onDelete: SetNull)
  leagues          League[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// A League Container: one user's fantasy league with its own teams, starred
// players, and scoring setup. scoringConfig's shape depends on scoringType and
// is validated by the sport engine's parseScoringConfig. The 10-league cap is
// enforced in lib/leagues/actions.ts, inside a transaction.
//
// Imported leagues (provider other than "manual") carry the host's identity:
// externalKey is the provider's league key, so re-importing the same league
// updates it instead of duplicating (unique per profile). myTeamId marks the
// team the user manages; the import writes it, and SetNull keeps the league
// valid if that team is ever removed. syncedAt / syncError record the latest
// refresh, and unsupportedCategories lists provider stat categories the sport
// descriptor cannot score, so the UI can say what was left out.
//
// syncVia records which path keeps an imported league in sync: "server" reads
// it from Yahoo directly, "extension" goes through the browser extension,
// because a private league can only be read from a logged-in browser.
//
// myTeamId must always name one of this league's own teams. The database
// cannot enforce that (the foreign key only checks that the team exists), so
// the importer asserts it before writing.
model League {
  id                    String                  @id @default(cuid())
  profileId             String                  @db.Uuid
  profile               Profile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name                  String
  slug                  String
  scoringType           String                  @default("h2h_categories")
  teamCount             Int                     @default(12)
  rosterSlots           Int                     @default(13)
  scoringConfig         Json
  provider              String                  @default("manual")
  externalKey           String?
  externalUrl           String?
  syncVia               String                  @default("server")
  myTeamId              String?                 @unique
  myTeam                LeagueTeam?             @relation("MyTeam", fields: [myTeamId], references: [id], onDelete: SetNull)
  syncedAt              DateTime?
  syncError             String?
  unsupportedCategories String[]                @default([])
  // The scored categories of an imported head-to-head league, in the host's
  // order: [{ statId, displayName, higherIsBetter }]. Null until a sync has
  // read them. Matchup stats are keyed by statId.
  statCategories        Json?
  teams                 LeagueTeam[]            @relation("LeagueTeams")
  matchups              LeagueMatchup[]
  watchlist             LeagueWatchlistPlayer[]
  waivers               LeagueWaiverPlayer[]
  activeFor             Profile[]               @relation("ActiveLeague")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([profileId, slug])
  @@unique([profileId, provider, externalKey])
}

// externalKey, logoUrl and managerName are filled by league imports; manual
// teams leave them null. Postgres treats nulls as distinct, so the
// [leagueId, externalKey] unique only constrains imported teams.
model LeagueTeam {
  id          String           @id @default(cuid())
  leagueId    String
  league      League           @relation("LeagueTeams", fields: [leagueId], references: [id], onDelete: Cascade)
  // Denormalized owner so RLS is a direct auth.uid() check, not a join.
  profileId   String           @db.Uuid
  name        String
  slug        String
  externalKey String?
  logoUrl     String?
  managerName String?
  // Back-relation: set when this is the team its league's user manages.
  myTeamOf    League?          @relation("MyTeam")
  slots       LeagueTeamSlot[]
  matchupsAsA LeagueMatchup[]  @relation("MatchupTeamA")
  matchupsAsB LeagueMatchup[]  @relation("MatchupTeamB")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([leagueId, slug])
  @@unique([leagueId, externalKey])
  @@index([profileId])
}

// An imported slot whose player could not be matched to a Player row keeps the
// provider's key and name (externalPlayerKey / externalPlayerName) with a null
// playerId, so the roster still shows who holds it. injuryStatus is the
// provider's status code ("Q", "O", "INJ", "P", ...), refreshed every sync.
model LeagueTeamSlot {
  id                 String     @id @default(cuid())
  teamId             String
  team               LeagueTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  profileId          String     @db.Uuid
  slotType           String
  position           Int
  playerId           Int?
  player             Player?    @relation(fields: [playerId], references: [id], onDelete: SetNull)
  externalPlayerKey  String?
  externalPlayerName String?
  injuryStatus       String?
  // The provider's own position label ("SG,SF,PF"), shown instead of the NBA
  // data's when present.
  displayPosition    String?

  @@unique([teamId, position])
  @@index([profileId])
}

// One head-to-head matchup of an imported league's current week, replaced on
// every sync. statsA / statsB are the two teams' week totals as the provider
// wrote them, keyed by statId: { "12": "412", "5": ".481" }. A bye retains
// team A's totals with no team B. syncedAt is independent of roster syncs.
model LeagueMatchup {
  id        String      @id @default(cuid())
  leagueId  String
  league    League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  // Denormalized owner so RLS is a direct auth.uid() check, not a join.
  profileId String      @db.Uuid
  week      Int
  weekStart String?
  weekEnd   String?
  status    String?
  teamAId   String
  teamA     LeagueTeam  @relation("MatchupTeamA", fields: [teamAId], references: [id], onDelete: Cascade)
  teamBId   String?
  teamB     LeagueTeam? @relation("MatchupTeamB", fields: [teamBId], references: [id], onDelete: Cascade)
  statsA    Json
  statsB    Json
  syncedAt  DateTime? // Null for rows written before scoreboard freshness was tracked.

  @@index([leagueId])
  @@index([profileId])
}

// Per-league starred players; replaces the global WatchlistPlayer. Same
// composite-natural-key design; the 50-row cap (per league now) stays in
// lib/watchlist/actions.ts.
model LeagueWatchlistPlayer {
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  playerId  Int
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  profileId String   @db.Uuid
  createdAt DateTime @default(now())

  @@id([leagueId, playerId])
  @@index([leagueId, createdAt(sort: Desc)])
  @@index([profileId])
}

// Maps a provider's player id (e.g. Yahoo's) onto our Player row. Written by
// the import matcher, which records how the match was made (method) and the
// positions the provider lists the player at. Server-only: RLS is on with no
// policies, and Prisma connects as a role that bypasses it. The table is shared
// by every profile, so only data the server fetched from Yahoo itself may write
// to it; a client-supplied snapshot never does.
model PlayerExternalId {
  provider          String
  externalId        String
  playerId          Int
  player            Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  method            String
  eligiblePositions String[] @default([])
  updatedAt         DateTime @updatedAt

  @@id([provider, externalId])
  @@index([playerId])
}

// Free agents (waiver pool) of an imported league, replaced on every sync so
// the pool tracks the host. Per-profile like the watchlist, with the owner
// denormalized so RLS is a direct auth.uid() check. injuryStatus is the
// provider's status code at the last sync.
model LeagueWaiverPlayer {
  leagueId        String
  league          League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  playerId        Int
  player          Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  profileId       String  @db.Uuid
  injuryStatus    String?
  // The provider's own position label ("PF,C"); see LeagueTeamSlot.
  displayPosition String?

  @@id([leagueId, playerId])
  @@index([profileId])
}

model PlayerSeasonStats {
  id          String   @id @default(cuid())
  player      Player   @relation(fields: [playerId], references: [id])
  playerId    Int
  season      String
  seasonType  String
  gamesPlayed Int
  minutes     Float
  fgm         Int
  fga         Int
  fg3m        Int
  fg3a        Int
  ftm         Int
  fta         Int
  oreb        Int
  dreb        Int
  reb         Int
  ast         Int
  stl         Int
  blk         Int
  tov         Int
  pts         Int
  updatedAt   DateTime @updatedAt

  @@unique([playerId, season, seasonType])
  // The unique index leads with playerId, so season-wide leaderboard reads
  // (which filter on season/seasonType alone) could not use it.
  @@index([season, seasonType])
}

model PlayerGameLog {
  id            String   @id @default(cuid())
  player        Player   @relation(fields: [playerId], references: [id])
  playerId      Int
  gameId        String
  gameDate      DateTime
  season        String
  seasonType    String
  teamId        Int
  teamAbbr      String
  matchup       String
  opponentAbbr  String?
  homeAway      String
  winLoss       String?
  teamScore     Int?
  opponentScore Int?
  minutes       Float
  fgm           Int
  fga           Int
  fg3m          Int
  fg3a          Int
  ftm           Int
  fta           Int
  oreb          Int
  dreb          Int
  reb           Int
  ast           Int
  stl           Int
  blk           Int
  tov           Int
  pts           Int
  plusMinus     Int?

  @@unique([playerId, gameId])
  @@index([gameDate])
  @@index([playerId, gameDate])
  // Season-scoped scans of the largest table (teams and valuation loaders)
  // had no usable index.
  @@index([season, seasonType])
}

// Per-game advanced metrics from Balldontlie's /v1/stats/advanced. Kept in
// its own table (same [playerId, gameId] identity as PlayerGameLog) so the
// advanced sync can replace seasons independently of box-score logs. Metrics
// are nullable: BDL returns null for players who logged no minutes.
model PlayerAdvancedGameLog {
  id                           String   @id @default(cuid())
  player                       Player   @relation(fields: [playerId], references: [id])
  playerId                     Int
  gameId                       String
  gameDate                     DateTime
  season                       String
  seasonType                   String
  teamId                       Int
  teamAbbr                     String
  pie                          Float?
  pace                         Float?
  assistPercentage             Float?
  assistRatio                  Float?
  assistToTurnover             Float?
  defensiveRating              Float?
  defensiveReboundPercentage   Float?
  effectiveFieldGoalPercentage Float?
  netRating                    Float?
  offensiveRating              Float?
  offensiveReboundPercentage   Float?
  reboundPercentage            Float?
  trueShootingPercentage       Float?
  turnoverRatio                Float?
  usagePercentage              Float?

  @@unique([playerId, gameId])
  @@index([playerId, gameDate])
}
