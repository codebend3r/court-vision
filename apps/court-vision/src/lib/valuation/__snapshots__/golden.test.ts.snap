exports[`valuation golden master keeps the same method and category copy 1`] = `
{
  "sample": "{categories:[{description:"Scoring contribution relative to the player pool.",formula:"(PTS − pool avg) ÷ pool std dev × weight",fullName:"Points",key:"pts",kind:"counting",label:"PTS"},{description:"Rebounding contribution relative to the player pool.",formula:"(REB − pool avg) ÷ pool std dev × weight",fullName:"Rebounds",key:"reb",kind:"counting",label:"REB"},{description:"Playmaking contribution relative to the player pool.",formula:"(AST − pool avg) ÷ pool std dev × weight",fullName:"Assists",key:"ast",kind:"counting",label:"AST"},{description:"Steals contribution relative to the player pool.",formula:"(STL − pool avg) ÷ pool std dev × weight",fullName:"Steals",key:"stl",kind:"counting",label:"STL"},{description:"Shot-blocking contribution relative to the player pool.",formula:"(BLK − pool avg) ÷ pool std dev × weight",fullName:"Blocks",key:"blk",kind:"counting",label:"BLK"},{description:"Three-point volume relative to the player pool.",formula:"(3PM − pool avg) ÷ pool std dev × weight",fullName:"Three-Pointers Made",key:"tpm",kind:"counting",label:"3PM"},{description:"Ball security. Fewer turnovers score higher — the sign is flipped.",formula:"(pool avg − TOV) ÷ pool std dev × weight",fullName:"Turnovers",key:"tov",kind:"counting",label:"TOV"},{description:"Field-goal percentage weighted by attempt volume, so high-volume efficiency beats empty percentages.",formula:"FGA × (FG% − pool FG%), standardized × weight",fullName:"Field Goal Impact",key:"fg",kind:"ratio",label:"FG%"},{description:"Free-throw percentage weighted by attempt volume, so high-volume efficiency beats empty percentages.",formula:"FTA × (FT% − pool FT%), standardized × weight",fullName:"Free Throw Impact",key:"ft",kind:"ratio",label:"FT%"}],methods:[{available:true,description:"Distance from the average pool player in each category, scaled by how spread out the category is, then summed with your weights.",formula:"Σ per category: (stat − pool avg) ÷ pool std dev × weight",fullName:"Z-Score Valuation",key:"zscore",label:"Z-Score",whyItMatters:"Use this to answer \\"who is better?\\" in a category league. It puts a 25-point scorer and a shot-blocking center on one scale, so you can rank off a single number instead of squinting at seven stat columns."},{available:true,description:"Z-Score's edge divided by both the between-player spread and each category's game-to-game volatility, so unreliable weekly edges count for less in H2H.",formula:"Σ per category: (stat − pool avg) ÷ √(spread² + volatility²) × weight",fullName:"G-Score Valuation",key:"gscore",label:"G-Score",whyItMatters:"Prefer this in weekly head-to-head. A player whose steals swing between 0 and 5 wins you that category some weeks and loses it others; G-Score trusts the steady producer more, and steady is what wins matchups."},{available:true,description:"The stat line priced in points-league scoring: PTS ×1, REB ×1.2, AST ×1.5, STL ×3, BLK ×3, TOV ×−1. Ignores category weights.",formula:"pts×1 + reb×1.2 + ast×1.5 + stl×3 + blk×3 − tov×1",fullName:"Points-League Linear",key:"points",label:"PL Linear",whyItMatters:"Only matters if your league adds up one score per player instead of tracking categories. If it does, this is the number that decides everything — ignore the other columns. If it doesn't, ignore this one."},{available:true,description:"Z-Score surplus over the last rostered player in your league (rank = teams × roster slots) — the real alternative on waivers.",formula:"zScore(player) − zScore(replacement at teams × slots)",fullName:"Value Over Replacement",key:"vorp",label:"VORP",whyItMatters:"Answers \\"how much would I actually lose by dropping him?\\" A player is only worth what he gives you over the best guy sitting on waivers, so this is the sanity check before you accept a trade or reach in a draft."},{available:true,description:"Z-Score surplus over the replacement player at the scarcest slot this player can fill (G/F/C parsed from position).",formula:"zScore(player) − min over eligibl",
  "sha256": "2363a72961f64581c34ac2c1210606d31b8ab64e26fb4516befbe9cedb0afc70",
}
`;

