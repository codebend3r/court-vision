{
  "name": "court-vision",
  "version": "0.3.2",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "predev": "build-meta --src-folder public --env development",
    "dev": "next dev --port 46644",
    "prebuild": "build-meta --src-folder public --env production",
    "build": "next build",
    "start": "next start",
    "lint": "bun run --sequential lint:spell lint:ts lint:scss",
    "lint:fix": "bun run --sequential lint:spell:fix lint:ts:fix lint:scss:fix",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "lint:scss": "gale \"src/**/*.scss\"",
    "lint:scss:fix": "gale --fix \"src/**/*.scss\"",
    "lint:spell": "typos",
    "lint:spell:fix": "typos --write-changes",
    "typecheck": "next typegen && tsgo --noEmit",
    "test": "bun test --parallel --dots",
    "test:a11y": "playwright test",
    "security:scan": "bun run scripts/security-scan.ts",
    "perf:budget": "bun run scripts/perf-budget.ts",
    "test:watch": "bun test --isolate --watch",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "prepare": "husky",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "postinstall": "prisma generate",
    "sync:nba": "bun run src/lib/nba/sync.ts",
    "sync:bdl": "bun run src/lib/balldontlie/sync.ts",
    "sync:players": "bun run src/lib/balldontlie/sync-players.ts",
    "seed:demo": "bun run src/lib/demo/seed.ts",
    "map:headshots": "bun run src/lib/headshots/map.ts",
    "system-check": "bun run --sequential format:check typecheck lint test build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "nuqs": "2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "zod": "4.6.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@codebend3r/gale": "0.2.1",
    "@happy-dom/global-registrator": "20.14.5",
    "@ocular-d/typos-bin": "1.50.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.2",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "build-meta": "0.1.1",
    "dotenv": "17.4.2",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "prisma": "7.10.0",
    "sass": "1.104.1",
    "typescript": "7.0.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@ocular-d/typos-bin",
    "@parcel/watcher",
    "@prisma/engines",
    "prisma",
    "sharp",
    "unrs-resolver"
  ]
}
