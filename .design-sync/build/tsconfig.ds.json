{
  "extends": "../../apps/court-vision/tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "skipLibCheck": true,
    "incremental": false,
    "composite": false,
    "baseUrl": "../..",
    "paths": {
      "@/*": ["apps/court-vision/src/*"],
      "@generated/*": ["apps/court-vision/generated/*"],
      "@public/*": ["apps/court-vision/public/*"]
    },
    "rootDir": "../..",
    "outDir": "../../types"
  },
  "include": ["../../apps/court-vision/next-env.d.ts", "entry.ts", "provider.tsx"],
  "exclude": ["../../node_modules"]
}
