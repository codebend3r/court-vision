{
  "extends": "../../apps/court-vision/tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "skipLibCheck": true,
    "incremental": false,
    "composite": false,
    "paths": {
      "@/*": ["../../apps/court-vision/src/*"],
      "@generated/*": ["../../apps/court-vision/generated/*"],
      "@public/*": ["../../apps/court-vision/public/*"]
    },
    "rootDir": "../..",
    "outDir": "../../types"
  },
  "include": [
    "../../apps/court-vision/next-env.d.ts",
    "entry.ts",
    "provider.tsx",
    "../../libs/vision-ui/src/components/*/*.tsx"
  ],
  "exclude": ["../../node_modules", "../../libs/**/*.test.tsx"]
}
