{
  "name": "@vision/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.scss"
  ],
  "scripts": {
    "test": "bun test --parallel --dots",
    "typecheck": "tsgo --noEmit"
  },
  "imports": {
    "#ui/components/*.module.scss": "./src/components/*.module.scss",
    "#ui/components/*": "./src/components/*.tsx",
    "#ui/styles/*": "./src/styles/*.scss",
    "#ui/*": "./src/*.ts"
  },
  "exports": {
    "./components/*.module.scss": "./src/components/*.module.scss",
    "./components/*": "./src/components/*.tsx",
    "./styles/*": "./src/styles/*.scss",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@vision/core": "workspace:*"
  },
  "peerDependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@vision/testing": "workspace:*"
  }
}
