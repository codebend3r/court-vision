#!/usr/bin/env sh
set -e

echo "Running pre-commit hook"

# Formats staged files with Oxfmt and fixes staged SCSS with Stylelint, then
# re-stages them. Commands inside one glob run in order, so Stylelint's --fix
# lands before Oxfmt has the final say on whitespace. Config: .lintstagedrc.json
bunx lint-staged

bun run typecheck && \
bun run lint && \
bun run test
